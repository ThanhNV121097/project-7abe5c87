# Local compose database user.
POSTGRES_USER=app

# Local compose database password. Development placeholder only.
POSTGRES_PASSWORD=app_secret

# Local compose database name.
POSTGRES_DB=app

# Host port mapped to backend container port 8080.
BACKEND_PORT=8080

# Host port mapped to frontend container port 3000.
FRONTEND_PORT=3000

# Browser-visible backend API base URL for frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8080
